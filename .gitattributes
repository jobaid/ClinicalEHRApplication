# Normalise line endings. The repository stores LF; Windows checkouts may use CRLF locally.
#
# Without this, editing a file on Windows can rewrite its line endings and make `git diff` report
# an entire file as changed when one line moved — which hides the real change in the noise, and
# is exactly what happened to src/app.jsx during development.
* text=auto eol=lf

# Files that must keep LF regardless of platform: these are read by Linux containers and by
# shells, where a stray CR breaks the shebang or the command.
*.sh        text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.go        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary: never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.dump binary

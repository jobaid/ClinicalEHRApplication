# Copy this file to .env and fill in the values from your Firebase project's
# Web App config (Firebase Console -> Project settings -> Your apps -> Web app).
# See README-FIREBASE.md for the full setup walkthrough.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" to make a local `npm run dev` talk to the real project above instead of the
# Firebase Local Emulator Suite. Leave unset (or "true") for local development against emulators.
VITE_USE_FIREBASE_EMULATOR=true

# Used only by scripts/seedFirestore.mjs when run with --prod (targets a real project instead of
# the emulators). Path to a service-account key JSON downloaded from
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=

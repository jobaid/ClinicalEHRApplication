# Firebase Authentication for project billing-d9417.
#
# Copy the values from the Firebase console:
#   Project settings > General > Your apps > Web app > SDK setup and configuration > Config
#
# These five are PUBLIC by design - they ship inside every web bundle that uses Firebase and are
# not secrets. What protects the project is the Firebase security rules and the authorised-domains
# list, not the obscurity of these values.
#
# Copy this file to .env.local (gitignored) and fill it in. Leave it unset and the application
# keeps using its own PostgreSQL-backed sign-in, unchanged.

# Firebase authentication is OFF unless this says exactly "firebase". Having the config below
# filled in is not enough, on purpose: a project's config often sits in .env.local for Firestore
# or hosting, and that must not quietly change who authenticates your staff.
VITE_AUTH_PROVIDER=

VITE_FIREBASE_API_KEY= AIzaSyBwvEmFp0MhMnANdN_nAmFUPA0XO0wvfZU
VITE_FIREBASE_AUTH_DOMAIN=billing-d9417.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=billing-d9417
VITE_FIREBASE_MESSAGING_SENDER_ID=1070594005227
VITE_FIREBASE_APP_ID=1:1070594005227:web:667e923d7c194ce47b46ae

# --- server side (server/.env or the container environment) ---
#
# The Go API verifies Firebase ID tokens against this project id. It is the `aud` claim check, and
# it is what stops an ID token minted for somebody else's Firebase project being accepted here.
#   FIREBASE_PROJECT_ID=billing-d9417
#
# While both are accepted, browsers already holding a Go-issued session keep working. Set this
# once every user has signed in through Firebase, to stop accepting the old tokens:
#   FIREBASE_ONLY=true

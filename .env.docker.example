# Copy to .env.docker and fill in. That file is gitignored and must stay that way.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# Nothing here has a working default on purpose. docker-compose.yml refuses to start when
# POSTGRES_PASSWORD or JWT_SECRET is missing, and the API refuses to start under
# APP_ENV=production without them too — a secret that is never guessable from this repository
# is worth more than a stack that starts on the first try.

# ---------- database ----------
POSTGRES_DB=medbill
POSTGRES_USER=medbill

# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- API ----------
# Signs session tokens. Anyone holding this value can mint a token for any account, including
# SUPER_ADMIN, so it must be random and must never be committed.
# Generate one:  openssl rand -base64 48
JWT_SECRET=

# Only consulted for cross-origin requests. The default stack serves the app and the API from one
# origin through nginx, so this is a formality there — set it to the real public origin when you
# host the frontend somewhere else.
CORS_ORIGINS=http://localhost:8080

# ---------- host ----------
# Host port the app is published on: http://localhost:<WEB_PORT>
WEB_PORT=8080

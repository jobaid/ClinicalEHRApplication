# Copy to .env.docker and fill in. That file is gitignored and must stay that way.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
#
# Nothing here has a working default on purpose. docker-compose.yml refuses to start when
# POSTGRES_PASSWORD or JWT_SECRET is missing, and the API refuses to start under
# APP_ENV=production without them too — a secret that is never guessable from this repository
# is worth more than a stack that starts on the first try.

# ---------- database ----------
POSTGRES_DB=medbill
POSTGRES_USER=medbill

# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- API ----------
# Signs session tokens. Anyone holding this value can mint a token for any account, including
# SUPER_ADMIN, so it must be random and must never be committed.
# Generate one:  openssl rand -base64 48
JWT_SECRET=

# Only consulted for cross-origin requests. The default stack serves the app and the API from one
# origin through nginx, so this is a formality there — set it to the real public origin when you
# host the frontend somewhere else.
CORS_ORIGINS=http://localhost:8080

# ---------- first sign-in ----------
# A new database contains no accounts, and POST /api/auth/users requires an existing SUPER_ADMIN,
# so a fresh deployment cannot be signed into until one exists. Set both and the API creates that
# first administrator on startup.
#
# It only ever acts on an EMPTY users table: once any account exists these are ignored and the
# server logs that it skipped them. Leaving them set is therefore not a back door — but unset them
# after your first sign-in regardless, so the password stops living in a file.
#
# Skip both if you are restoring an existing database dump; it already has your accounts.
BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters. Generate one:  openssl rand -base64 24
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- host ----------
# Host port the app is published on: http://localhost:<WEB_PORT>
#
# Behind a reverse proxy (CloudPanel, Caddy, a load balancer) prefix it with 127.0.0.1 so the
# stack is reachable ONLY through that proxy and never directly from the internet:
#   WEB_PORT=127.0.0.1:8080
WEB_PORT=8080

# ---------- demonstration account (optional) ----------
# Leave BOTH blank and no demo account exists: the panel never appears on the login page. That is
# the right setting for a practice running real billing.
#
# Set both and the server creates ONE extra account, role MANAGER, whose password is printed on
# the login page and which is the only account exempt from authenticator verification. It cannot
# overwrite an existing user: if this address already belongs to a real account, the server logs
# a refusal and changes nothing.
#
# Before enabling this against a database holding real patient information, read section 27 of
# DEPLOYMENT.md - anyone on the internet can sign in with these credentials and a MANAGER can
# read patient records.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Manager Demo
